# ==================== Data Models ====================

@dataclass
class VisionResult:
    """Vision processing result"""
    fps: float = 0.0
    faces: List[Tuple[int, int, int, int]] = None
    objects: List[Tuple[str, float, int, int, int, int]] = None
    qr_codes: List[str] = None
    barcodes: List[str] = None
    text_detected: List[str] = None
    
    def __post_init__(self):
        self.faces = self.faces or []
        self.objects = self.objects or []
        self.qr_codes = self.qr_codes or []
        self.barcodes = self.barcodes or []
        self.text_detected = self.text_detected or []
        
# ==================== Advanced Tracker Classes ====================

class TrackedObject:
    """Represents a tracked object with history"""
    def __init__(self, tracker, bbox, label="Object", confidence=1.0):
        self.id = str(uuid.uuid4())[:8]
        self.tracker = tracker
        self.bbox = bbox  # (x, y, w, h)
        self.label = label
        self.confidence = confidence
        self.trail = []  # Position history
        self.frames_since_update = 0
        self.max_trail_length = 30
        self.color = (np.random.randint(50, 255), 
                      np.random.randint(50, 255), 
                      np.random.randint(50, 255))
        self.last_seen = time.time()
        self.predicted_bbox = bbox
        
    def update(self, bbox, confidence=1.0):
        """Update object position"""
        self.bbox = bbox
        self.confidence = confidence
        self.frames_since_update = 0
        self.last_seen = time.time()
        
        # Update trail
        center_x = bbox[0] + bbox[2] // 2
        center_y = bbox[1] + bbox[3] // 2
        self.trail.append((center_x, center_y))
        if len(self.trail) > self.max_trail_length:
            self.trail.pop(0)
    
    def predict_next_position(self):
        """Predict next position using linear extrapolation"""
        if len(self.trail) >= 3:
            dx = self.trail[-1][0] - self.trail[-2][0]
            dy = self.trail[-1][1] - self.trail[-2][1]
            next_x = self.trail[-1][0] + dx
            next_y = self.trail[-1][1] + dy
            self.predicted_bbox = (
                next_x - self.bbox[2]//2,
                next_y - self.bbox[3]//2,
                self.bbox[2],
                self.bbox[3]
            )
        return self.predicted_bbox

class AdvancedTracker:
    """Advanced object tracking with multiple algorithms - OpenCV 5.0 compatible"""
    
    # Don't define TRACKER_TYPES as a class variable!
    # We'll check for trackers dynamically when needed
    
    def __init__(self, tracker_type='auto', max_objects=10, min_confidence=0.3):
        self.max_objects = max_objects
        self.min_confidence = min_confidence
        self.tracked_objects = []
        self.frame_width = 640
        self.frame_height = 480
        self.next_id = 0
        self.mutex = QMutex()
        
        # Auto-detect best available tracker
        if tracker_type == 'auto':
            self.tracker_type = self._get_best_available_tracker()
        else:
            self.tracker_type = tracker_type
        
        # Log which tracker we're using
        if self.tracker_type:
            print(f"✅ AdvancedTracker initialized with: {self.tracker_type}")
        else:
            print("⚠️ AdvancedTracker: No real tracker available - using dummy")
    
    def _get_best_available_tracker(self):
        """Get the best available tracker type - OpenCV 5.0 compatible"""
        # Check for CSRT first (best accuracy) - available in OpenCV 4.5+
        if hasattr(cv2, 'TrackerCSRT_create'):
            print("✅ Using CSRT tracker (best accuracy)")
            return 'CSRT'
        # Check for KCF (good speed/accuracy)
        elif hasattr(cv2, 'TrackerKCF_create'):
            print("✅ Using KCF tracker (good speed/accuracy)")
            return 'KCF'
        # Check for MedianFlow (good for small movements)
        elif hasattr(cv2, 'TrackerMedianFlow_create'):
            print("✅ Using MedianFlow tracker")
            return 'MEDIANFLOW'
        # Check for legacy trackers (older OpenCV versions)
        elif hasattr(cv2, 'legacy'):
            if hasattr(cv2.legacy, 'TrackerCSRT_create'):
                print("✅ Using legacy CSRT tracker")
                return 'legacy_CSRT'
            elif hasattr(cv2.legacy, 'TrackerKCF_create'):
                print("✅ Using legacy KCF tracker")
                return 'legacy_KCF'
        # Try to use the generic tracker
        elif hasattr(cv2, 'Tracker_create'):
            print("✅ Using generic tracker")
            return 'GENERIC'
        else:
            print("⚠️ No tracker available - using dummy tracker")
            return None
    
    def create_tracker(self, tracker_type=None):
        """Create a new tracker instance - OpenCV 5.0 compatible"""
        tracker_type = tracker_type or self.tracker_type
        
        try:
            # OpenCV 5.0+ trackers (MOSSE removed)
            if tracker_type == 'CSRT' and hasattr(cv2, 'TrackerCSRT_create'):
                return cv2.TrackerCSRT_create()
            elif tracker_type == 'KCF' and hasattr(cv2, 'TrackerKCF_create'):
                return cv2.TrackerKCF_create()
            elif tracker_type == 'MEDIANFLOW' and hasattr(cv2, 'TrackerMedianFlow_create'):
                return cv2.TrackerMedianFlow_create()
            
            # Legacy trackers (older OpenCV versions)
            elif hasattr(cv2, 'legacy'):
                if tracker_type == 'legacy_CSRT' and hasattr(cv2.legacy, 'TrackerCSRT_create'):
                    return cv2.legacy.TrackerCSRT_create()
                elif tracker_type == 'legacy_KCF' and hasattr(cv2.legacy, 'TrackerKCF_create'):
                    return cv2.legacy.TrackerKCF_create()
            
            # Generic tracker
            elif hasattr(cv2, 'Tracker_create'):
                return cv2.Tracker_create()
                
        except Exception as e:
            print(f"Error creating tracker: {e}")
        
        # If no tracker available, create a dummy tracker
        class DummyTracker:
            def __init__(self):
                self.bbox = None
            def init(self, frame, bbox):
                self.bbox = bbox
                return True
            def update(self, frame):
                return True, self.bbox if self.bbox else (0, 0, 100, 100)
        
        return DummyTracker()
    
    def init_tracker(self, frame, bbox, label="Object", confidence=1.0):
        """Initialize a new tracker for an object"""
        tracker = self.create_tracker()
        try:
            if tracker and tracker.init(frame, bbox):
                obj = TrackedObject(tracker, bbox, label, confidence)
                self.tracked_objects.append(obj)
                return obj
        except Exception as e:
            print(f"Error initializing tracker: {e}")
        return None
    
    def update(self, frame):
        """Update all tracked objects"""
        if not self.tracked_objects:
            return []
        
        updated_objects = []
        objects_to_remove = []
        
        self.mutex.lock()
        try:
            for obj in self.tracked_objects:
                try:
                    success, bbox = obj.tracker.update(frame)
                    if success:
                        # Convert to tuple of ints
                        bbox = tuple(map(int, bbox))
                        obj.update(bbox)
                        updated_objects.append(obj)
                        obj.frames_since_update = 0
                    else:
                        obj.frames_since_update += 1
                        # Remove if lost for too long
                        if obj.frames_since_update > 30:  # ~1 second at 30fps
                            objects_to_remove.append(obj)
                except Exception as e:
                    # If tracker fails, remove it
                    objects_to_remove.append(obj)
            
            # Remove lost objects
            for obj in objects_to_remove:
                if obj in self.tracked_objects:
                    self.tracked_objects.remove(obj)
            
        finally:
            self.mutex.unlock()
        
        return updated_objects
    
    def get_object_at_position(self, x, y, threshold=50):
        """Find tracked object near position"""
        for obj in self.tracked_objects:
            bbox = obj.bbox
            center_x = bbox[0] + bbox[2] // 2
            center_y = bbox[1] + bbox[3] // 2
            distance = ((center_x - x) ** 2 + (center_y - y) ** 2) ** 0.5
            if distance < threshold:
                return obj
        return None
    
    def draw_tracks(self, frame, show_trail=True, show_bbox=True, show_label=True):
        """Draw tracked objects on frame"""
        for obj in self.tracked_objects:
            bbox = obj.bbox
            x, y, w, h = bbox
            
            # Draw bounding box
            if show_bbox:
                cv2.rectangle(frame, (x, y), (x+w, y+h), obj.color, 2)
                
                # Draw confidence
                if obj.confidence > 0.5:
                    cv2.rectangle(frame, (x, y-20), (x+80, y-5), obj.color, -1)
                    cv2.putText(frame, f"{obj.label} {obj.confidence:.2f}", 
                               (x+5, y-8), cv2.FONT_HERSHEY_SIMPLEX, 0.4, (255,255,255), 1)
            
            # Draw trail
            if show_trail and len(obj.trail) > 1:
                points = np.array(obj.trail, dtype=np.int32).reshape((-1, 1, 2))
                cv2.polylines(frame, [points], False, obj.color, 2)
                
                # Draw predicted position
                predicted = obj.predict_next_position()
                px, py, pw, ph = map(int, predicted)
                cv2.rectangle(frame, (px, py), (px+pw, py+ph), obj.color, 1, cv2.LINE_DASHED)
            
            # Draw ID
            if show_label:
                cv2.putText(frame, f"ID:{obj.id}", (x, y+h+15), 
                           cv2.FONT_HERSHEY_SIMPLEX, 0.4, obj.color, 1)
    
    def clear(self):
        """Clear all tracked objects"""
        self.tracked_objects = []
        self.next_id = 0

class FaceTracker(AdvancedTracker):
    """Specialized face tracker with recognition capabilities"""
    
    def __init__(self, max_faces=10, recognition_model=None):
        super().__init__(tracker_type='auto', max_objects=max_faces)  # Changed to 'auto'
        self.face_encodings = {}
        self.face_names = {}
        self.recognition_model = recognition_model
        self.face_detector = cv2.CascadeClassifier(
            cv2.data.haarcascades + 'haarcascade_frontalface_default.xml'
        )
        self.eye_detector = cv2.CascadeClassifier(
            cv2.data.haarcascades + 'haarcascade_eye.xml'
        )
        
    def detect_faces(self, frame):
        """Detect faces in frame"""
        try:
            gray = cv2.cvtColor(frame, cv2.COLOR_RGB2GRAY)
            faces = self.face_detector.detectMultiScale(gray, 1.1, 5, 
                                                        minSize=(60, 60))
            
            # Detect eyes for each face
            detected_faces = []
            for (x, y, w, h) in faces:
                roi_gray = gray[y:y+h, x:x+w]
                eyes = self.eye_detector.detectMultiScale(roi_gray)
                
                # Only consider faces with eyes
                if len(eyes) >= 1:
                    confidence = min(1.0, len(eyes) / 2.0)
                    detected_faces.append((x, y, w, h, confidence))
            
            return detected_faces
        except Exception as e:
            print(f"Error detecting faces: {e}")
            return []
    
    def update_faces(self, frame, detected_faces):
        """Update tracked faces with new detections"""
        # Track existing faces
        self.update(frame)
        
        # Match new detections to existing objects
        for (x, y, w, h, confidence) in detected_faces:
            bbox = (x, y, w, h)
            
            # Check if this face is already tracked
            matched = False
            for obj in self.tracked_objects:
                if self._iou(bbox, obj.bbox) > 0.3:
                    # Re-initialize tracker for better tracking
                    new_tracker = self.create_tracker()
                    if new_tracker and new_tracker.init(frame, bbox):
                        obj.tracker = new_tracker
                        obj.update(bbox, confidence)
                        matched = True
                        break
            
            # New face
            if not matched and len(self.tracked_objects) < self.max_objects:
                self.init_tracker(frame, bbox, "Face", confidence)
    
    def _iou(self, bbox1, bbox2):
        """Calculate Intersection over Union"""
        x1, y1, w1, h1 = bbox1
        x2, y2, w2, h2 = bbox2
        
        x_left = max(x1, x2)
        y_top = max(y1, y2)
        x_right = min(x1 + w1, x2 + w2)
        y_bottom = min(y1 + h1, y2 + h2)
        
        if x_right < x_left or y_bottom < y_top:
            return 0.0
        
        intersection = (x_right - x_left) * (y_bottom - y_top)
        area1 = w1 * h1
        area2 = w2 * h2
        union = area1 + area2 - intersection
        
        return intersection / union if union > 0 else 0        

class VisionMode(Enum):
    """Vision processing modes"""
    NORMAL = "normal"
    FACES = "faces"
    OBJECTS = "objects"
    QR = "qr"
    TEXT = "text"
    EDGE = "edge"
    SEGMENT = "segment"

# ==================== Vision Processing Engine ====================

class VisionEngine(QThread):
    """Background thread for vision processing"""
    
    frame_ready = Signal(QImage)
    result_ready = Signal(VisionResult)
    status_changed = Signal(str)
    frame_with_tracking_ready = Signal(QImage, object)  # New signal for tracking
    
    
    def __init__(self):
        super().__init__()
        self.camera = None
        self.running = False
        self.mode = VisionMode.NORMAL
        self.mutex = QMutex()
        self.face_cascade = None
        self.object_detector = None
        self.qr_detector = None
        
        # Performance tracking
        self.frame_count = 0
        self.fps_timer = QElapsedTimer()
        self.fps = 0.0
        
        # Tracking data
        self.tracking_active = False
        self.face_tracker = None
        self.advanced_tracker = None
        self.tracking_frame = None
        
        # Initialize detectors
        self._init_detectors()
        
    def set_tracking_data(self, face_tracker, advanced_tracker, tracking_active):
        """Set tracking data from UI"""
        self.face_tracker = face_tracker
        self.advanced_tracker = advanced_tracker
        self.tracking_active = tracking_active    
        
    def _init_detectors(self):
        """Initialize computer vision detectors"""
        try:
            # Face detection
            face_cascade_path = cv2.data.haarcascades + 'haarcascade_frontalface_default.xml'
            self.face_cascade = cv2.CascadeClassifier(face_cascade_path)
            
            # QR code detector
            self.qr_detector = cv2.QRCodeDetector()
            
            # Initialize object detector (using pre-trained MobileNet SSD)
            self.object_detector = None  # Would load model here
            self.status_changed.emit("Vision engine initialized")
            
        except Exception as e:
            self.status_changed.emit(f"Error initializing detectors: {str(e)}")
    
    def start_camera(self, camera_id: int = 0):
        """Start the camera"""
        self.mutex.lock()
        try:
            if self.camera is not None:
                self.camera.release()
            
            self.camera = cv2.VideoCapture(camera_id)
            self.camera.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
            self.camera.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
            self.camera.set(cv2.CAP_PROP_FPS, 30)
            
            self.running = True
            self.fps_timer.start()
            self.frame_count = 0
            
            if not self.isRunning():
                self.start()
                
            self.status_changed.emit(f"Camera {camera_id} started")
            
        except Exception as e:
            self.status_changed.emit(f"Error starting camera: {str(e)}")
        finally:
            self.mutex.unlock()
    
    def stop_camera(self):
        """Stop the camera"""
        self.mutex.lock()
        self.running = False
        if self.camera:
            self.camera.release()
            self.camera = None
        self.mutex.unlock()
        self.status_changed.emit("Camera stopped")
    
    def set_mode(self, mode: VisionMode):
        """Set vision processing mode"""
        self.mode = mode
        self.status_changed.emit(f"Mode: {mode.value}")
    
    def run(self):
        """Main processing loop"""
        while self.running:
            self.mutex.lock()
            if self.camera is None or not self.camera.isOpened():
                self.mutex.unlock()
                self.msleep(10)
                continue
        
            ret, frame = self.camera.read()
            self.mutex.unlock()
        
            if not ret:
                continue
        
            # Process frame
            processed_frame, result = self._process_frame(frame)
        
            # Update FPS
            self.frame_count += 1
            if self.fps_timer.elapsed() >= 1000:
                self.fps = self.frame_count * 1000 / self.fps_timer.elapsed()
                self.frame_count = 0
                self.fps_timer.restart()
            result.fps = self.fps
        
            # Convert to QImage
            height, width, channel = processed_frame.shape
            bytes_per_line = 3 * width
            qimage = QImage(processed_frame.data, width, height, bytes_per_line, QImage.Format_RGB888)
        
            # Emit signals
            self.frame_ready.emit(qimage)
            self.result_ready.emit(result)
        
            # Process tracking in the background thread
            if self.tracking_active and self.face_tracker and self.advanced_tracker:
                try:
                    # Clone frame for tracking
                    tracking_frame = processed_frame.copy()
                
                    # Run tracking
                    face_count = 0
                    obj_count = 0
                
                    # Face tracking
                    if self.face_tracker:
                        detected_faces = self.face_tracker.detect_faces(tracking_frame)
                        if detected_faces:
                            self.face_tracker.update_faces(tracking_frame, detected_faces)
                        else:
                            self.face_tracker.update(tracking_frame)
                        face_count = len(self.face_tracker.tracked_objects)
                    
                        if face_count > 0:
                            self.face_tracker.draw_tracks(tracking_frame, show_trail=True, show_bbox=True)
                
                    # Object tracking
                    if self.advanced_tracker:
                        self.advanced_tracker.update(tracking_frame)
                        obj_count = len(self.advanced_tracker.tracked_objects)
                    
                        if obj_count > 0:
                            self.advanced_tracker.draw_tracks(tracking_frame, show_trail=True, show_bbox=True)
                
                    # Emit tracking frame
                    if face_count > 0 or obj_count > 0:
                        tracking_qimage = QImage(tracking_frame.data, width, height, bytes_per_line, QImage.Format_RGB888)
                        self.frame_with_tracking_ready.emit(tracking_qimage, (face_count, obj_count))
                    
                except Exception as e:
                    print(f"Tracking error in engine: {e}")
        
            self.msleep(10)  # Control frame rate
    
    def _process_frame(self, frame: np.ndarray) -> Tuple[np.ndarray, VisionResult]:
        """Process a single frame based on current mode"""
        result = VisionResult()
        processed = frame.copy()
        
        # Convert to RGB for display
        processed = cv2.cvtColor(processed, cv2.COLOR_BGR2RGB)
        
        # Apply different processing modes
        if self.mode == VisionMode.FACES:
            processed, result.faces = self._detect_faces(processed)
        elif self.mode == VisionMode.QR:
            processed, result.qr_codes = self._scan_qr(processed)
        elif self.mode == VisionMode.EDGE:
            processed = self._detect_edges(processed)
        elif self.mode == VisionMode.TEXT:
            processed, result.text_detected = self._detect_text(processed)
        elif self.mode == VisionMode.NORMAL:
            # Just pass through
            pass
        
        return processed, result
    
    def _detect_faces(self, frame: np.ndarray) -> Tuple[np.ndarray, List[Tuple[int, int, int, int]]]:
        """Detect faces in the frame"""
        if self.face_cascade is None:
            return frame, []
        
        gray = cv2.cvtColor(frame, cv2.COLOR_RGB2GRAY)
        faces = self.face_cascade.detectMultiScale(gray, 1.1, 4)
        
        for (x, y, w, h) in faces:
            cv2.rectangle(frame, (x, y), (x+w, y+h), (0, 255, 0), 2)
            cv2.putText(frame, f"Face", (x, y-10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)
        
        return frame, [(x, y, w, h) for (x, y, w, h) in faces]
    
    def _scan_qr(self, frame: np.ndarray) -> Tuple[np.ndarray, List[str]]:
        """Scan for QR codes and barcodes"""
        qr_codes = []
        try:
            # QR Code detection
            data, bbox, _ = self.qr_detector.detectAndDecode(frame)
            if data:
                qr_codes.append(data)
                if bbox is not None:
                    bbox = bbox.astype(int)
                    cv2.polylines(frame, [bbox], True, (0, 255, 0), 2)
                    cv2.putText(frame, f"QR: {data}", (bbox[0][0][0], bbox[0][0][1]-10),
                              cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)
            
            # Barcode detection (using pyzbar if available)
            try:
                from pyzbar.pyzbar import decode
                decoded = decode(cv2.cvtColor(frame, cv2.COLOR_RGB2GRAY))
                for obj in decoded:
                    barcode_data = obj.data.decode('utf-8')
                    qr_codes.append(f"Barcode: {barcode_data}")
                    points = obj.polygon
                    if len(points) == 4:
                        pts = [(p.x, p.y) for p in points]
                        cv2.polylines(frame, [np.array(pts, dtype=int)], True, (0, 255, 0), 2)
            except ImportError:
                pass  # pyzbar not installed
                
        except Exception as e:
            pass
        
        return frame, qr_codes
    
    def _detect_edges(self, frame: np.ndarray) -> np.ndarray:
        """Detect edges using Canny"""
        gray = cv2.cvtColor(frame, cv2.COLOR_RGB2GRAY)
        edges = cv2.Canny(gray, 50, 150)
        return cv2.cvtColor(edges, cv2.COLOR_GRAY2RGB)
    
    def _detect_text(self, frame: np.ndarray) -> Tuple[np.ndarray, List[str]]:
        """Detect text in the frame (placeholder)"""
        # This would use Tesseract or similar
        return frame, ["Text detection placeholder"]

# ==================== Vision Panel Widget ====================

class VisionPanel(QWidget):
    """Main vision panel widget"""
    
    def __init__(self, live=None, parent=None, runtime_core=None):
        """
        Initialize the VisionPanel
    
        Args:
            live: Live instance (optional)
            parent: QWidget parent (must be a QWidget or None)
            runtime_core: BusterRuntimeCore instance (optional)
        """
        # FIXED: Handle case where runtime_core is passed as live
        if live is not None and not isinstance(live, QWidget):
            # If live is not a QWidget, it might be runtime_core
            if isinstance(live, BusterRuntimeCore):
                if runtime_core is None:
                    runtime_core = live
                live = None
            else:
                # Could be some other object, keep it as live
                pass
    
        # Validate parent
        if parent is not None and not isinstance(parent, QWidget):
            # If parent is not a QWidget, it might be runtime_core passed incorrectly
            if runtime_core is None and isinstance(parent, BusterRuntimeCore):
                runtime_core = parent
            parent = None
    
        # Now safely call QWidget.__init__ with a valid parent
        super().__init__(parent)
    
        self.live = live
        self.runtime_core = runtime_core
    
        self.vision = VisionEngine()
        self.current_result = VisionResult()
        
        # Initialize new tracking features
        self.tracking_active = False
        self.motion_detection_active = False
        self.face_recognition_active = False
        self.recording_active = False
        self.prev_frame = None
        self.motion_threshold = 5000
        self.known_faces = {}
        self.video_writer = None
        self.recording_filename = ""
        
        # Initialize advanced trackers
        self.advanced_tracker = None
        self.face_tracker = None
        self._prev_gray = None
    
        self.setup_ui()
        self.connect_signals()
        self.apply_dark_theme()
        
        # Add enhanced tracking controls
        self.add_tracking_controls()
        
        # Replace frame update with tracking version
        self.vision.frame_ready.connect(self.update_frame_with_tracking)
        
    def connect_signals(self):
        """Connect signals to slots"""
        self.start_btn.clicked.connect(self.start_camera)
        self.stop_btn.clicked.connect(self.stop_camera)
        self.photo_btn.clicked.connect(self.take_photo)
    
        self.vision.result_ready.connect(self.update_info)
        self.vision.status_changed.connect(self.update_status)
        # Connect tracking frame signal
        self.vision.frame_with_tracking_ready.connect(self.update_frame_with_tracking)

    def update_frame_with_tracking(self, qimage: QImage, tracking_data: tuple):
        """Update frame with tracking data from background thread"""
        # Update the image display
        pixmap = QPixmap.fromImage(qimage)
        scaled = pixmap.scaled(
            self.image_label.size(),
            Qt.KeepAspectRatio,
            Qt.SmoothTransformation
        )
        self.image_label.setPixmap(scaled)
    
        # Update tracking stats
        face_count, obj_count = tracking_data
        self.stats_labels["faces"].setText(f"Faces: {face_count}")
        self.stats_labels["objects"].setText(f"Objects: {obj_count}")
    
        total_objects = face_count + obj_count
        if total_objects > 0:
            self.status_label.setText(f"🎯 Tracking {total_objects} objects ({face_count} faces, {obj_count} objects)")
            self.status_label.setStyleSheet("color: #4ec9b0; font-weight: bold;")
        else:
            self.status_label.setText("🔍 No objects detected")
            self.status_label.setStyleSheet("color: #dcdcaa; font-weight: bold;")    
        
    def setup_ui(self):
        """Setup the user interface"""
        layout = QVBoxLayout(self)
        layout.setSpacing(10)
        layout.setContentsMargins(10, 10, 10, 10)
        
        # ===== Header =====
        header_widget = QWidget()
        header_layout = QHBoxLayout(header_widget)
